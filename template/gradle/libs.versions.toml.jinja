[versions]
agp = "9.4.1"
{%- if include_networking %}
buildKonfig = "0.17.1"
{%- endif %}
android-compileSdk = "36"
android-minSdk = "24"
android-targetSdk = "36"
androidx-activityCompose = "1.11.0"
androidx-lifecycle = "2.9.6"
androidx-navigation = "2.9.1"
compose-multiplatform = "1.9.3"
kermit = "2.0.8"
koin = "4.1.1"
koinAnnotations = "2.3.1"
kotlin = "2.2.21"
{%- if include_networking %}
ktor = "3.3.2"
{%- endif %}
kotlinxCoroutines = "1.10.2"
kotlinxSerializationJson = "1.9.0"
{%- if include_bottom_nav %}
# The version material3-adaptive-navigation-suite 1.9.0 (Compose 1.9.3) requires.
material3Adaptive = "1.1.2"
# Material icons are frozen at 1.7.3 upstream.
materialIcons = "1.7.3"
{%- endif %}
ksp = "2.3.3"
mokkery = "3.0.0"
{%- if include_desktop and include_networking %}
slf4j = "2.0.17"
{%- endif %}
{%- if include_sonar %}
sonarqube = "7.5.0.8588"
{%- endif %}
{%- if include_persistence %}
room = "2.8.3"
sqlite = "2.6.1"
{%- endif %}

[libraries]
androidx-activity-compose = { module = "androidx.activity:activity-compose", version.ref = "androidx-activityCompose" }
androidx-lifecycle-runtime-compose = { module = "org.jetbrains.androidx.lifecycle:lifecycle-runtime-compose", version.ref = "androidx-lifecycle" }
androidx-lifecycle-viewmodel = { module = "org.jetbrains.androidx.lifecycle:lifecycle-viewmodel", version.ref = "androidx-lifecycle" }
androidx-navigation-compose = { module = "org.jetbrains.androidx.navigation:navigation-compose", version.ref = "androidx-navigation" }
kotlin-test = { module = "org.jetbrains.kotlin:kotlin-test", version.ref = "kotlin" }
{%- if include_persistence %}
room-compiler = { module = "androidx.room:room-compiler", version.ref = "room" }
room-runtime = { module = "androidx.room:room-runtime", version.ref = "room" }
sqlite-bundled = { module = "androidx.sqlite:sqlite-bundled", version.ref = "sqlite" }
{%- endif %}
kermit = { module = "co.touchlab:kermit-core", version.ref = "kermit" }
koin-android = { module = "io.insert-koin:koin-android", version.ref = "koin" }
koin-annotations = { module = "io.insert-koin:koin-annotations", version.ref = "koinAnnotations" }
koin-annotations-ksp = { module = "io.insert-koin:koin-ksp-compiler", version.ref = "koinAnnotations" }
koin-compose = { module = "io.insert-koin:koin-compose", version.ref = "koin" }
koin-compose-viewmodel = { module = "io.insert-koin:koin-compose-viewmodel", version.ref = "koin" }
koin-core = { module = "io.insert-koin:koin-core", version.ref = "koin" }
koin-test = { module = "io.insert-koin:koin-test", version.ref = "koin" }
{%- if include_desktop %}
kotlinx-coroutines-swing = { module = "org.jetbrains.kotlinx:kotlinx-coroutines-swing", version.ref = "kotlinxCoroutines" }
{%- endif %}
kotlinx-coroutines-test = { module = "org.jetbrains.kotlinx:kotlinx-coroutines-test", version.ref = "kotlinxCoroutines" }
kotlinx-serialization-json = { module = "org.jetbrains.kotlinx:kotlinx-serialization-json", version.ref = "kotlinxSerializationJson" }

{%- if include_networking %}
ktor-client-content-negotiation = { module = "io.ktor:ktor-client-content-negotiation", version.ref = "ktor" }
ktor-client-core = { module = "io.ktor:ktor-client-core", version.ref = "ktor" }
ktor-client-darwin = { module = "io.ktor:ktor-client-darwin", version.ref = "ktor" }
ktor-client-logging = { module = "io.ktor:ktor-client-logging", version.ref = "ktor" }
ktor-client-mock = { module = "io.ktor:ktor-client-mock", version.ref = "ktor" }
ktor-client-okhttp = { module = "io.ktor:ktor-client-okhttp", version.ref = "ktor" }
ktor-serialization-kotlinx-json = { module = "io.ktor:ktor-serialization-kotlinx-json", version.ref = "ktor" }
{%- endif %}

{%- if include_bottom_nav %}
material3-adaptive = { module = "org.jetbrains.compose.material3.adaptive:adaptive", version.ref = "material3Adaptive" }
material-icons-core = { module = "org.jetbrains.compose.material:material-icons-core", version.ref = "materialIcons" }
{%- endif %}

{%- if include_desktop and include_networking %}
slf4j-nop = { module = "org.slf4j:slf4j-nop", version.ref = "slf4j" }
{%- endif %}

[plugins]
androidApplication = { id = "com.android.application", version.ref = "agp" }
androidKotlinMultiplatformLibrary = { id = "com.android.kotlin.multiplatform.library", version.ref = "agp" }
{%- if include_networking %}
buildKonfig = { id = "com.codingfeline.buildkonfig", version.ref = "buildKonfig" }
{%- endif %}
composeMultiplatform = { id = "org.jetbrains.compose", version.ref = "compose-multiplatform" }
composeCompiler = { id = "org.jetbrains.kotlin.plugin.compose", version.ref = "kotlin" }
kotlinMultiplatform = { id = "org.jetbrains.kotlin.multiplatform", version.ref = "kotlin" }
kotlinSerialization = { id = "org.jetbrains.kotlin.plugin.serialization", version.ref = "kotlin" }
ksp = { id = "com.google.devtools.ksp", version.ref = "ksp" }
mokkery = { id = "dev.mokkery", version.ref = "mokkery" }
{%- if include_sonar %}
sonarqube = { id = "org.sonarqube", version.ref = "sonarqube" }
{%- endif %}
{%- if include_persistence %}
room = { id = "androidx.room", version.ref = "room" }
{%- endif %}
