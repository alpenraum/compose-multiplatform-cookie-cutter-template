{% if include_networking %}import com.codingfeline.buildkonfig.compiler.FieldSpec
{% endif %}{% if include_desktop %}import org.jetbrains.compose.desktop.application.dsl.TargetFormat
{% endif %}{% if include_persistence %}import org.jetbrains.kotlin.gradle.ExperimentalKotlinGradlePluginApi
{% endif %}import org.jetbrains.kotlin.gradle.dsl.JvmTarget
{%- if include_persistence %}
import org.jetbrains.kotlin.gradle.plugin.KotlinPlatformType
{%- endif %}
import org.jetbrains.kotlin.gradle.tasks.KotlinCompilationTask
import java.util.Properties
{%- if include_desktop %}
import java.util.UUID
{%- endif %}

plugins {
    alias(libs.plugins.kotlinMultiplatform)
    alias(libs.plugins.androidApplication)
    alias(libs.plugins.composeMultiplatform)
    alias(libs.plugins.composeCompiler)
    alias(libs.plugins.kotlinSerialization)
    alias(libs.plugins.ksp)
    alias(libs.plugins.mokkery)
{%- if include_persistence %}
    alias(libs.plugins.room)
{%- endif %}
{%- if include_networking %}
    alias(libs.plugins.buildKonfig)
{%- endif %}
}

val appVersion = Properties().apply { rootProject.file("version.properties").inputStream().use(::load) }
{%- if include_desktop %}
val versionProperties = listOf("app.versionName", "app.versionCode").associateWith { appVersion.getProperty(it) }
{%- endif %}

kotlin {
    compilerOptions {
        freeCompilerArgs.add("-Xexpect-actual-classes")
    }
{%- if include_persistence %}

    // sqliteTest: tests against a real in-memory database, on every target that has one without a Context.
    @OptIn(ExperimentalKotlinGradlePluginApi::class)
    applyDefaultHierarchyTemplate {
        common {
            group("sqlite") {
                withIos()
{%- if include_desktop %}
                withJvm()
{%- endif %}
            }
        }
    }
{%- endif %}

    androidTarget {
        compilerOptions {
            jvmTarget.set(JvmTarget.JVM_11)
        }
    }

{%- if include_desktop %}

    jvm("desktop")
{%- endif %}

    listOf(
        iosX64(),
        iosArm64(),
        iosSimulatorArm64()
    ).forEach { iosTarget ->
        iosTarget.binaries.framework {
            baseName = "ComposeApp"
            isStatic = true
            binaryOption("bundleId", "{{ package_name }}.shared")
        }
    }

    sourceSets {
        commonMain {
            // Koin annotation processing runs once on common code; every target compiles its output.
            kotlin.srcDir(layout.buildDirectory.dir("generated/ksp/metadata/commonMain/kotlin"))

            dependencies {
                implementation(compose.runtime)
                implementation(compose.foundation)
                implementation(compose.material3)
{%- if include_bottom_nav %}
                implementation(compose.material3AdaptiveNavigationSuite)
                implementation(libs.material3.adaptive)
                implementation(libs.material.icons.core)
{%- endif %}
                implementation(compose.ui)
                implementation(compose.components.resources)
                implementation(compose.components.uiToolingPreview)
                implementation(libs.androidx.lifecycle.viewmodel)
                implementation(libs.androidx.lifecycle.runtime.compose)
                implementation(libs.androidx.navigation.compose)

                implementation(libs.koin.core)
                implementation(libs.koin.compose)
                implementation(libs.koin.compose.viewmodel)
                implementation(libs.koin.annotations)

                implementation(libs.kermit)
                implementation(libs.kotlinx.serialization.json)
{%- if include_networking %}

                implementation(libs.ktor.client.core)
                implementation(libs.ktor.client.content.negotiation)
                implementation(libs.ktor.client.logging)
                implementation(libs.ktor.serialization.kotlinx.json)
{%- endif %}
{%- if include_persistence %}

                implementation(libs.room.runtime)
                implementation(libs.sqlite.bundled)
{%- endif %}
            }
        }

        commonTest.dependencies {
            implementation(libs.kotlin.test)
            implementation(libs.kotlinx.coroutines.test)
{%- if include_networking %}
            implementation(libs.ktor.client.mock)
{%- endif %}
        }

        androidUnitTest.dependencies {
            implementation(libs.koin.test)
        }

        androidMain.dependencies {
            implementation(compose.preview)
            implementation(libs.androidx.activity.compose)
            implementation(libs.koin.android)
{%- if include_networking %}
            implementation(libs.ktor.client.okhttp)
{%- endif %}
        }
{%- if include_desktop %}

        val desktopMain by getting {
            dependencies {
                implementation(compose.desktop.currentOs)
                implementation(libs.kotlinx.coroutines.swing)
{%- if include_networking %}
                implementation(libs.ktor.client.okhttp)
                // Ktor logs through HttpLogger; this only silences SLF4J's missing-provider warning.
                runtimeOnly(libs.slf4j.nop)
{%- endif %}
            }
        }
{%- endif %}
{%- if include_networking %}

        iosMain.dependencies {
            implementation(libs.ktor.client.darwin)
        }
{%- endif %}
    }
}

dependencies {
    add("kspCommonMainMetadata", libs.koin.annotations.ksp)
{%- if include_persistence %}
    // Room generates per-target code (AppDatabaseConstructor actuals), so it runs on every target.
    kotlin.targets
        .filter { it.platformType != KotlinPlatformType.common }
        .forEach { add("ksp${it.targetName.replaceFirstChar(Char::uppercase)}", libs.room.compiler) }
{%- endif %}
}
{%- if include_persistence %}

room {
    schemaDirectory("$projectDir/db-schemas")
}
{%- endif %}

// Every compilation and every per-target KSP run reads the Koin code generated from common sources.
tasks.withType<KotlinCompilationTask<*>>().configureEach {
    if (name != "kspCommonMainKotlinMetadata") dependsOn("kspCommonMainKotlinMetadata")
}
tasks.matching { it.name.startsWith("ksp") && it.name != "kspCommonMainKotlinMetadata" }.configureEach {
    dependsOn("kspCommonMainKotlinMetadata")
}

ksp {
    arg("KOIN_USE_COMPOSE_VIEWMODEL", "true")
    arg("KOIN_CONFIG_CHECK", "false")
}

{% if include_networking -%}
buildkonfig {
    packageName = "{{ package_name }}"

    // Select with -Pbuildkonfig.flavor=dev; no flavor = production.
    defaultConfigs {
        buildConfigField(FieldSpec.Type.STRING, "baseUrl", "https://api.example.invalid/")
    }
    defaultConfigs("dev") {
        buildConfigField(FieldSpec.Type.STRING, "baseUrl", "https://dev.api.example.invalid/")
    }
}

{% endif -%}
compose.resources {
    packageOfResClass = "{{ package_name }}.resources"
}

android {
    namespace = "{{ package_name }}"
    compileSdk =
        libs.versions.android.compileSdk
            .get()
            .toInt()

    defaultConfig {
        applicationId = "{{ package_name }}"
        minSdk =
            libs.versions.android.minSdk
                .get()
                .toInt()
        targetSdk =
            libs.versions.android.targetSdk
                .get()
                .toInt()
        versionCode = appVersion.getProperty("app.versionCode").toInt()
        versionName = appVersion.getProperty("app.versionName")
    }
    packaging {
        resources {
            excludes += "/META-INF/{AL2.0,LGPL2.1}"
        }
    }
    buildTypes {
        getByName("release") {
            proguardFiles(
                getDefaultProguardFile("proguard-android-optimize.txt"),
                "proguard-rules.pro"
            )
            isMinifyEnabled = true
        }
        getByName("debug") {
            applicationIdSuffix = ".dev"
        }
    }
    buildFeatures {
        buildConfig = true
    }
    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_11
        targetCompatibility = JavaVersion.VERSION_11
    }
}

dependencies {
    debugImplementation(compose.uiTooling)
}
{%- if include_desktop %}

compose.desktop {
    application {
        mainClass = "{{ package_name }}.MainKt"
        jvmArgs += versionProperties.map { (key, value) -> "-D$key=$value" }

        buildTypes.release.proguard {
            configurationFiles.from(project.file("proguard-desktop.pro"))
        }

        nativeDistributions {
            targetFormats(TargetFormat.Dmg, TargetFormat.Msi, TargetFormat.Deb)
            packageName = "{{ app_name }}"
            // Dmg requires MAJOR > 0.
            packageVersion = appVersion.getProperty("app.versionName")
            vendor = "{{ author }}"
            // Both identities must never change after the first release.
            macOS { bundleID = "{{ package_name }}" }
            windows { upgradeUuid = UUID.nameUUIDFromBytes("{{ package_name }}".toByteArray()).toString() }
        }
    }
}

// Every launcher (run, desktopRun, runRelease, IDE) sees the version; only the dev entry points are debug.
tasks.withType<JavaExec>().configureEach {
    systemProperties(versionProperties)
    if (name == "run" || name == "desktopRun") systemProperty("app.debug", "true")
}
{%- endif %}
