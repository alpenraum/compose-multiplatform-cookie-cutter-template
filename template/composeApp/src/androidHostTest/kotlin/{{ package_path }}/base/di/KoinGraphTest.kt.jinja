// The compiler plugin checks the graph at each entry point at build time; this resolves it at runtime. JVM only:
// the plugin cannot see main-compilation definitions from Kotlin/Native test compilations.
@OptIn(ExperimentalCoroutinesApi::class)
class KoinGraphTest {
    // ViewModels start their scope on the main dispatcher; JVM host tests have none.
    @BeforeTest
    fun setUp() {
        initializeTestPlatform()
        Dispatchers.setMain(StandardTestDispatcher())
    }

    @AfterTest
    fun tearDown() {
        Dispatchers.resetMain()
    }

    @Test
    fun appGraphResolves() {
{%- if include_persistence %}
        // Opening a real database needs a platform context; everything above the DAO resolves for real.
        val testOverrides = module { single<SampleItemDao> { mock() } }
{%- endif %}
        val koin =
            koinApplication<{{ app_name }}Koin> {
                modules(platformModule())
{%- if include_persistence %}
                modules(testOverrides)
{%- endif %}
            }.koin

        koin.get<DispatchersProvider>()
        koin.get<{{ app_name }}Logger>()
        koin.get<AddSampleItemUseCase>()
{%- if include_persistence %}
        koin.get<SampleRepository>()
{%- endif %}
{%- if include_networking %}
        koin.get<RemoteSampleDataSource>()
        koin.get<HttpClient>().close()
{%- endif %}
        koin.get<SampleViewModel>()
        koin.get<SampleDetailViewModel> { parametersOf(1L) }
        assertTrue(koin.get<NavViewModel>().navGraphs.isNotEmpty())
    }
}
