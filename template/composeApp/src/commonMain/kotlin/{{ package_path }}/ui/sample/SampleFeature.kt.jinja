private data class TitleError(
    val message: StringResource,
    val maxLength: Int? = null,
)

@Composable
fun SampleFeature(
    navController: NavController,
    viewModel: SampleViewModel = koinViewModel(),
) {
    val (state, dispatch, events) = use(viewModel, navController)
    val snackbarHostState = remember { SnackbarHostState() }
    val scope = rememberCoroutineScope()
    var title by rememberSaveable { mutableStateOf("") }
    var titleError by remember { mutableStateOf<TitleError?>(null) }
    var errorDetails by remember { mutableStateOf<AppError?>(null) }

    CollectEvents(events) { event ->
        when (event) {
            SampleContract.Event.ItemAdded -> title = ""
            SampleContract.Event.TitleBlank -> titleError = TitleError(Res.string.sample_title_blank)
            is SampleContract.Event.TitleTooLong -> titleError = TitleError(Res.string.sample_title_too_long, event.maxLength)
            // Launched: showSnackbar suspends until dismissed and would hold back every later event.
            is SampleContract.Event.ShowError ->
                scope.launch { if (snackbarHostState.showError(event.error)) errorDetails = event.error }
        }
    }

    Scaffold(
        snackbarHost = { SnackbarHost(snackbarHostState) },
        contentWindowInsets = ScaffoldDefaults.contentWindowInsets.union(WindowInsets.ime),
    ) { padding ->
        Column(
            modifier = Modifier.padding(padding).padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(16.dp),
        ) {
            Row(
                horizontalArrangement = Arrangement.spacedBy(8.dp),
                verticalAlignment = Alignment.CenterVertically,
            ) {
                OutlinedTextField(
                    value = title,
                    onValueChange = {
                        title = it
                        titleError = null
                    },
                    label = { Text(stringResource(Res.string.sample_input_label)) },
                    isError = titleError != null,
                    supportingText = titleError?.let { error -> { Text(error.text()) } },
                    singleLine = true,
                    modifier = Modifier.weight(1f),
                )
                Button(onClick = { dispatch(SampleContract.Intent.OnAddItem(title)) }) {
                    Text(stringResource(Res.string.sample_add))
                }
            }
            SampleContent(
                state = state,
                onItemSelected = { dispatch(SampleContract.Intent.OnItemSelected(it)) },
                onRetry = { dispatch(SampleContract.Intent.OnRetry) },
            )
        }
    }

    errorDetails?.let { ErrorDialog(error = it, onDismiss = { errorDetails = null }) }
}

@Composable
private fun TitleError.text(): String = if (maxLength == null) stringResource(message) else stringResource(message, maxLength)

@Composable
private fun SampleContent(
    state: SampleContract.State,
    onItemSelected: (Long) -> Unit,
    onRetry: () -> Unit,
) {
    when (state) {
        SampleContract.State.Loading ->
            Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) { CircularProgressIndicator() }

        SampleContract.State.Empty ->
            Text(stringResource(Res.string.sample_empty))

        is SampleContract.State.Loaded ->
            LazyColumn(Modifier.fillMaxWidth()) {
                items(state.items, key = { it.id }) { item ->
                    ListItem(
                        headlineContent = { Text(item.title) },
                        modifier = Modifier.clickable { onItemSelected(item.id) },
                    )
                }
            }

        is SampleContract.State.Failed ->
            ErrorView(error = state.error, onRetry = onRetry, modifier = Modifier.fillMaxWidth())
    }
}
