package {{ package_name }}.ui.main

import androidx.navigation.NavController
import androidx.navigation.NavGraphBuilder
import androidx.navigation.compose.composable
import androidx.navigation.compose.navigation
import androidx.navigation.toRoute
import {{ package_name }}.ui.base.navigation.NavDestinationDefinition
import {{ package_name }}.ui.base.navigation.NavGraphDefinition
import {{ package_name }}.ui.sample.SampleDetailFeature
import {{ package_name }}.ui.sample.SampleFeature
{%- if include_bottom_nav %}
import {{ package_name }}.ui.settings.SettingsFeature
{%- endif %}
import kotlinx.serialization.Serializable
import org.koin.core.annotation.Single

@Single(binds = [NavGraphDefinition::class])
class MainNavigationGraph : NavGraphDefinition {
    override fun build(
        navGraphBuilder: NavGraphBuilder,
        navController: NavController,
    ) {
        navGraphBuilder.navigation<MainRoute.Root>(startDestination = MainRoute.Home) {
            composable<MainRoute.Home> {
                SampleFeature(navController)
            }
{%- if include_bottom_nav %}
            composable<MainRoute.Settings> {
                SettingsFeature()
            }
{%- endif %}
            composable<MainRoute.SampleDetail> { entry ->
                SampleDetailFeature(navController, itemId = entry.toRoute<MainRoute.SampleDetail>().itemId)
            }
        }
    }
}

@Serializable
sealed interface MainRoute : NavDestinationDefinition {
    @Serializable
    data object Root : MainRoute

    @Serializable
    data object Home : MainRoute
{%- if include_bottom_nav %}

    @Serializable
    data object Settings : MainRoute
{%- endif %}

    @Serializable
    data class SampleDetail(
        val itemId: Long,
    ) : MainRoute
}
