// The bar shows only on these routes; every other screen covers it.
enum class TopLevelDestination(
    val route: MainRoute,
    val label: StringResource,
    val icon: ImageVector,
    val selectedIcon: ImageVector,
) {
    ITEMS(MainRoute.Home, Res.string.tab_items, Icons.AutoMirrored.Outlined.List, Icons.AutoMirrored.Filled.List),
    SETTINGS(MainRoute.Settings, Res.string.tab_settings, Icons.Outlined.Settings, Icons.Filled.Settings),
}

@Composable
fun TopLevelNavigationSuite(
    navController: NavController,
    content: @Composable () -> Unit,
) {
    val currentDestination = navController.currentBackStackEntryAsState().value?.destination
    val current =
        TopLevelDestination.entries.firstOrNull { destination ->
            currentDestination?.hierarchy?.any { it.hasRoute(destination.route::class) } == true
        }
    val imeVisible = WindowInsets.ime.getBottom(LocalDensity.current) > 0
    // Hidden while typing: the keyboard covers the bar, and its height would otherwise be padded twice.
    val layoutType =
        if (current == null || imeVisible) {
            NavigationSuiteType.None
        } else {
            NavigationSuiteScaffoldDefaults.calculateFromAdaptiveInfo(currentWindowAdaptiveInfoV2())
        }

    NavigationSuiteScaffold(
        layoutType = layoutType,
        navigationSuiteItems = {
            TopLevelDestination.entries.forEach { destination ->
                val selected = destination == current
                item(
                    selected = selected,
                    onClick = { navController.navigateToTopLevel(destination.route) },
                    icon = { Icon(if (selected) destination.selectedIcon else destination.icon, contentDescription = null) },
                    label = { Text(stringResource(destination.label)) },
                )
            }
        },
        content = content,
    )
}
