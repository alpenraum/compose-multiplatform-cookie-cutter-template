package {{ package_name }}.data.db

import androidx.room.Dao
import androidx.room.Insert
import androidx.room.Query
import {{ package_name }}.data.db.model.SampleItemEntity
import kotlinx.coroutines.flow.Flow

@Dao
interface SampleItemDao {
    @Query("SELECT * FROM ${SampleItemEntity.TABLE_NAME} ORDER BY id")
    fun observeAll(): Flow<List<SampleItemEntity>>

    @Query("SELECT * FROM ${SampleItemEntity.TABLE_NAME} WHERE id = :id")
    fun observe(id: Long): Flow<SampleItemEntity?>

    @Insert
    suspend fun insert(item: SampleItemEntity)
}
