package {{ package_name }}.base.error

import kotlin.coroutines.cancellation.CancellationException

sealed interface AppError {
    // Shown to users for support: structured facts only, never stack traces, URLs or payloads.
    val technicalDetail: String

    class Unexpected(
        val cause: Throwable,
    ) : AppError {
        override val technicalDetail: String = "unexpected: ${cause::class.simpleName}"
    }
{%- if include_persistence %}

    data class Storage(
        val operation: String,
    ) : AppError {
        override val technicalDetail: String = "storage: $operation"
    }
{%- endif %}
{%- if include_networking %}

    sealed interface Network : AppError {
        val endpoint: String

        data class Unreachable(
            override val endpoint: String,
        ) : Network {
            override val technicalDetail: String = "network: unreachable $endpoint"
        }

        data class Timeout(
            override val endpoint: String,
        ) : Network {
            override val technicalDetail: String = "network: timeout $endpoint"
        }

        data class Http(
            override val endpoint: String,
            val status: Int,
        ) : Network {
            override val technicalDetail: String = "network: http $status $endpoint"
        }

        data class InvalidResponse(
            override val endpoint: String,
        ) : Network {
            override val technicalDetail: String = "network: invalid response $endpoint"
        }
    }
{%- endif %}
}

class AppException(
    val error: AppError,
    cause: Throwable? = null,
) : Exception(error.technicalDetail, cause)

// Last resort: boundaries that know their failure modes throw a specific AppException first.
fun Throwable.toAppError(): AppError =
    when (this) {
        is CancellationException -> throw this
        is AppException -> error
        else -> AppError.Unexpected(this)
    }
